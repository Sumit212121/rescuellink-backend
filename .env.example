# ===============================================
# RescueLink Backend - Environment Configuration
# ===============================================

# Django Security Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configuration (MySQL local / TiDB Cloud Starter)
# For local MySQL:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=rescueconnect_db
# DB_USER=root
# DB_PASSWORD=your_local_password
#
# For TiDB Cloud Starter:
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_NAME=rescueconnect_db
# DB_USER=your_tidb_username
# DB_PASSWORD=your_tidb_password
# DB_SSL=true

DB_NAME=rescueconnect_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional: TiDB SSL settings
DB_SSL=false
# DB_SSL_CA=

# CORS & CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
